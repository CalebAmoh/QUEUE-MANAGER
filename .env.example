# Frontend (Vite) configuration — copy to .env and adjust as needed.
# Every value is optional; unset values fall back to the defaults in src/config.ts.

# Backend server URL (same host + port 9002 by default)
VITE_BACKEND_URL=http://kiosk-host:9002

# External bank self-service API (biometric device network)
VITE_SELF_SERVICE_API_URL=http://10.203.14.169:8082/api/self-service

# Biometric SDK host
VITE_SDK_BASE_URL=http://localhost:8080

# Imaging / hard-biometric transaction host
VITE_IMAGING_URL=http://10.203.14.169/imaging

# Fraud-reporting API
VITE_FRAUD_API_URL=https://ibanking.sibll.com:9283/ibank/api/v2.0/user
VITE_FRAUD_API_KEY=20171411891
VITE_FRAUD_DEVICE_IP=10.203.14.169

# Fund-transfer proxy credentials
VITE_FUND_TRANSFER_API_SECRET=testPC
VITE_FUND_TRANSFER_POST_BY=UNIONADMIN
VITE_FUND_TRANSFER_CHANNEL=MOB

# Statement proxy headers
STATEMENT_API_KEY=self
STATEMENT_API_SECRET=self
STATEMENT_FORWARDED_FOR=10.203.18.237

# Staff360 XAuth (cross-authentication) — admin login via X100 staff credentials
VITE_XAUTH_HOST=http://10.203.14.15:8080
VITE_XAUTH_APP_KEY=your-app-key
